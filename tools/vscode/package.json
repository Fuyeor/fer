{
  "name": "fer",
  "displayName": "Fer Analyzer",
  "description": "Fer Programming Language support for VS Code",
  "version": "0.0.1",
  "publisher": "Fuyeor",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fuyeor/fer"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:fer"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node ./test/grammar.test.mjs && node ./test/server.test.mjs",
    "prepare:server": "node ./scripts/prepare-server.mjs",
    "package": "npm run compile && vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fer",
        "extensions": [
          ".fer",
          ".fon"
        ],
        "configuration": "./language-configuration.json",
        "brackets": []
      }
    ],
    "grammars": [
      {
        "language": "fer",
        "scopeName": "source.fer",
        "path": "./syntaxes/fer.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Fer Lavender (Dark)",
        "uiTheme": "vs-dark",
        "path": "./themes/fer-lavender.dark.json"
      }
    ],
    "configuration": {
      "title": "Fer",
      "properties": {
        "fer.server.path": {
          "type": "string",
          "default": "fer-lsp",
          "description": "Command or absolute path used to start the Fer language server."
        },
        "fer.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional command-line arguments passed to fer-lsp."
        }
      }
    },
    "configurationDefaults": {
      "[fer]": {
        "editor.bracketPairColorization.enabled": false,
        "editor.guides.bracketPairs": false
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.block.fer",
            "settings": {
              "foreground": "#8b949e",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "comment.line.double-slash.fer",
            "settings": {
              "foreground": "#8b949e",
              "fontStyle": "italic"
            }
          },
          {
            "scope": "comment.line.triple-slash.fer",
            "settings": {
              "foreground": "#8b949e",
              "fontStyle": "italic"
            }
          },
          {
            "scope": [
              "punctuation.bracket.fer",
              "punctuation.separator.fer"
            ],
            "settings": {
              "foreground": "#cad1d8"
            }
          },
          {
            "scope": "keyword.control.fer",
            "settings": {
              "foreground": "#89befa"
            }
          },
          {
            "scope": "keyword.operator.logical.fer",
            "settings": {
              "foreground": "#b79bf4"
            }
          },
          {
            "scope": "keyword.operator.assignment.fer",
            "settings": {
              "foreground": "#b79bf4"
            }
          },
          {
            "scope": "support.type.primitive.fer",
            "settings": {
              "foreground": "#d5a789"
            }
          },
          {
            "scope": "entity.name.type.fer",
            "settings": {
              "foreground": "#d5a789"
            }
          },
          {
            "scope": "entity.name.function.fer",
            "settings": {
              "foreground": "#b79bf4"
            }
          },
          {
            "scope": "string.quoted.fer",
            "settings": {
              "foreground": "#cad1d8"
            }
          },
          {
            "scope": "variable.interpolation.fer",
            "settings": {
              "foreground": "#b79bf4"
            }
          },
          {
            "scope": "constant.numeric.fer",
            "settings": {
              "foreground": "#cad1d8"
            }
          },
          {
            "scope": "constant.boolean.fer",
            "settings": {
              "foreground": "#cad1d8"
            }
          },
          {
            "scope": "variable.other.constant.fer",
            "settings": {
              "foreground": "#b79bf4"
            }
          }
        ]
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.9.2",
    "@vscode/vsce": "^3.6.0"
  }
}
