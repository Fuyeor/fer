{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fer",
  "scopeName": "source.fer",
  "patterns": [
    { "include": "#comments" },
    { "include": "#punctuation" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#constants" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block.fer", "begin": "/\\*", "end": "\\*/" },
        { "name": "comment.line.double-slash.fer", "match": "//.*" },
        { "name": "comment.line.triple-slash.fer", "match": "///.*" }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.fer",
          "match": "[{}()\\[\\]]"
        },
        {
          "name": "punctuation.separator.fer",
          "match": "[,]"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.fer",
          "match": "\\b(i8|i16|i32|i64|i128|u8|u16|u32|u64|u128|f32|f64|bool|string|char|byte|int|float)\\b"
        },
        {
          "name": "entity.name.type.fer",
          "match": "\\b[A-Z][a-z0-9-]*(?=\\s*=\\s*(enum|struct))\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.fer",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "constant.character.escape.fer",
          "match": "\\\\."
        },
        {
          "name": "variable.interpolation.fer",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "source.fer" }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fer",
          "match": "\\b(struct|enum|exports|all|any|one|none)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.fer",
          "match": "\\b(not|in|contains|matches|starts|ends|less|more|least|most|equals)\\b"
        },
        {
          "name": "keyword.operator.comparison.fer",
          "match": "(<|>|<=|>=)"
        },
        {
          "name": "keyword.operator.assignment.fer",
          "match": "(=|->|=>)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b([a-z][a-z0-9-]*)\\s*(?=\\=\\s*\\()",
          "name": "entity.name.function.fer"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.numeric.fer", "match": "\\b[0-9]+\\b" },
        {
          "name": "constant.boolean.fer",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.other.constant.fer",
          "match": "\\b([a-z][a-z0-9-]*)\\s*(?=\\=)"
        }
      ]
    }
  }
}
