// examples/condition.fer
x = 1

// Basic comparison.
y1 = (x > 1)

// Quantifiers accept comma or newline-separated conditions.
y2 = any (x > 1, x equals 1)
y3 = any (not (x > 1), x equals 1)
y4 = not (any (x > 1, x equals 1))

uuid4 = `8dd24bce-89c0-41e1-bd2a-4a02ae3735cc`
print(uuid4 {
  `UUID` { `It equals the string "UUID"` }
  contains `UUID` { `It contains the string "UUID"` }
  { `No match` }
})

ua = `Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)`
asn = 13414
legitimate-ua = `Googlebot`

status = any (
ua contains legitimate-ua
all (asn equals 13414, ua contains `Googlebot`)
all (asn equals 14618, ua contains `redditbot`)
) {
  true { `Allowed bot` }
  { `Disallowed bot` }
}

print(status)
