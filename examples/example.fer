/// @/examples/example.fer
{ candidates, score-value -> score } = ./constants

Status: enum { nice, pass, failed }

Candidate: struct {
  id: i32
  nickname: string
  username: string
  gender: enum { ai, female, male, nonbinary }
}

result = score {
  >= 90 { Status.nice }
  >= 60 { Status.pass }
  { Status.failed }
}

print(`{candidates[0]}'s score is {score}, result is {result}`)
